# ============================================================================
#  SukaPedia Email Worker — Environment Variables Template
# ============================================================================
#  Cara pakai:
#    1. Copy file ini jadi catatan pribadi (JANGAN commit nilai asli ke Git).
#    2. Buka Cloudflare Dashboard → Workers & Pages → pilih Worker.
#    3. Tab "Settings" → "Variables and Secrets" → Add satu per satu.
#    4. Pilih tipe "Secret" untuk nilai sensitif, "Text" untuk yang lain.
#    5. Klik "Deploy" ulang setelah selesai menambahkan semua variable.
#
#  ⚠️  JANGAN commit file .env asli ke Git. Yang di-commit hanya .env.example ini.
# ============================================================================


# ----------------------------------------------------------------------------
#  1. AUTENTIKASI
# ----------------------------------------------------------------------------
# Kunci rahasia untuk memvalidasi setiap request dari Flask.
# Generate dengan salah satu perintah:
#   • Linux/macOS : openssl rand -hex 32
#   • Windows PS  : -join ((1..64) | ForEach { '{0:x}' -f (Get-Random -Max 16) })
#
# Nilai ini HARUS sama dengan EMAIL_WORKER_KEY di .env Flask.
# Tipe di Cloudflare: Secret
API_KEY=ganti-dengan-hasil-openssl-rand-hex-32


# ----------------------------------------------------------------------------
#  2. SMTP CONFIG
# ----------------------------------------------------------------------------
# Host server SMTP.
#   Gmail            : smtp.gmail.com
#   Google Workspace : smtp.gmail.com
#   Brevo            : smtp-relay.brevo.com
#   Mailgun          : smtp.mailgun.org
#   SendGrid         : smtp.sendgrid.net
#   Mailjet          : in-v3.mailjet.com
#   Zoho             : smtp.zoho.com
#   Outlook/O365     : smtp.office365.com
#   Yahoo            : smtp.mail.yahoo.com
# Tipe di Cloudflare: Text
SMTP_HOST=smtp.gmail.com


# Port SMTP. Pilihan yang didukung:
#   465  → Implicit TLS   (REKOMENDASI — paling stabil)
#   587  → STARTTLS       (alternatif)
#   25   → Plain          (jarang, biasanya diblokir)
#   2525 → STARTTLS       (khusus Mailgun & Brevo)
# Tipe di Cloudflare: Text
SMTP_PORT=465


# Username SMTP (biasanya alamat email pengirim).
# Catatan per provider:
#   • Gmail          → email lengkap, misal user@gmail.com
#   • SendGrid       → literal "apikey" (bukan email)
#   • Mailgun        → postmaster@domain.com
#   • Brevo          → email akun login Brevo
# Tipe di Cloudflare: Text
SMTP_USER=sukapedia.id@gmail.com


# Password SMTP.
# KHUSUS GMAIL: wajib "App Password" 16 karakter (bukan password akun biasa).
#   Cara generate: https://myaccount.google.com/apppasswords
#   Aktifkan dulu 2-Step Verification di:
#     https://myaccount.google.com/security
#   Copy 16 karakter TANPA spasi, contoh: abcdefghijklmnop
# Tipe di Cloudflare: Secret
SMTP_PASSWORD=ganti-dengan-app-password-16-char


# Alamat pengirim (nama + email).
# Format: "Nama Display <email@domain.com>"
# KHUSUS GMAIL: harus SAMA dengan SMTP_USER, kalau beda → error 550.
# Untuk provider lain: boleh pakai domain yang sudah diverifikasi (SPF/DKIM).
# Tipe di Cloudflare: Text
SMTP_FROM=SukaPedia <sukapedia.id@gmail.com>


# ----------------------------------------------------------------------------
#  3. BRANDING (opsional)
# ----------------------------------------------------------------------------
# Nama brand yang muncul di footer template HTML email.
# Default: "SukaPedia"
# Tipe di Cloudflare: Text
BRAND_NAME=SukaPedia


# ============================================================================
#  CONTOH KONFIGURASI PER PROVIDER
# ============================================================================

# ----------------------------------------------------------------------------
#  A. GMAIL
# ----------------------------------------------------------------------------
# API_KEY=rahasia-panjang-anda-123
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=sukapedia.id@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# SMTP_FROM=SukaPedia <sukapedia.id@gmail.com>
# BRAND_NAME=SukaPedia
#
# Limit    : ~500 email/hari
# Catatan  : Wajib App Password, tidak bisa pakai password akun.


# ----------------------------------------------------------------------------
#  B. BREVO (dulu Sendinblue)
# ----------------------------------------------------------------------------
# API_KEY=rahasia-panjang-anda-123
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=nama@email.com
# SMTP_PASSWORD=brevo-smtp-key-dari-dashboard
# SMTP_FROM=SukaPedia <noreply@sukapedia.id>
# BRAND_NAME=SukaPedia
#
# Limit    : 300 email/hari gratis
# Setup    : Daftar di https://brevo.com → SMTP & API → catat credentials.


# ----------------------------------------------------------------------------
#  C. MAILGUN
# ----------------------------------------------------------------------------
# API_KEY=rahasia-panjang-anda-123
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=465
# SMTP_USER=postmaster@sukapedia.id
# SMTP_PASSWORD=mailgun-smtp-password
# SMTP_FROM=SukaPedia <noreply@sukapedia.id>
# BRAND_NAME=SukaPedia
#
# Catatan  : Wajib verifikasi domain (SPF/DKIM) sebelum production.


# ----------------------------------------------------------------------------
#  D. SENDGRID
# ----------------------------------------------------------------------------
# API_KEY=rahasia-panjang-anda-123
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=SukaPedia <noreply@sukapedia.id>
# BRAND_NAME=SukaPedia
#
# PENTING  : SMTP_USER harus literal "apikey" (bukan email).
# Setup    : Daftar di https://sendgrid.com → Settings → API Keys → Create.


# ============================================================================
#  ENV FLASK (terpisah dari env Worker)
# ============================================================================
# Variabel berikut TIDAK diset di Cloudflare Worker, melainkan di file .env
# milik aplikasi Flask kamu. Fungsinya untuk memanggil Worker dari backend.
#
#   EMAIL_WORKER_URL=https://sukapedia-email.<username>.workers.dev
#   EMAIL_WORKER_KEY=rahasia-panjang-anda-123
#
# EMAIL_WORKER_URL : URL Worker (tanpa trailing slash).
# EMAIL_WORKER_KEY : HARUS sama dengan API_KEY di atas.
#
# Contoh .env Flask lengkap:
#
#   # --- Flask ---
#   FLASK_ENV=production
#   SECRET_KEY=rahasia-flask-session-key
#
#   # --- Email Worker ---
#   EMAIL_WORKER_URL=https://sukapedia-email.username.workers.dev
#   EMAIL_WORKER_KEY=rahasia-panjang-anda-123
#
#   # --- Webhook (opsional) ---
#   IS_WEBHOOK=true
#   DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# ============================================================================